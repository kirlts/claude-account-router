#!/usr/bin/env bash
# Runtime guard in front of /usr/bin/killall: see lib/kill_guard.py. Fails closed.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
python3 -I "$ROOT/lib/kill_guard.py" killall "$@" || exit 1
for d in /usr/bin /bin; do [ -x "$d/killall" ] && exec "$d/killall" "$@"; done; echo 'killall: no system killall found' >&2; exit 127
