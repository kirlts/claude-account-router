#!/usr/bin/env bash
# Runtime guard in front of /usr/bin/pkill: see lib/kill_guard.py. Fails closed.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
python3 -I "$ROOT/lib/kill_guard.py" pkill "$@" || exit 1
for d in /usr/bin /bin; do [ -x "$d/pkill" ] && exec "$d/pkill" "$@"; done; echo 'pkill: no system pkill found' >&2; exit 127
