#!/usr/bin/env bash
# claude-account: see and switch the Claude Code accounts this machine holds.
#
#   claude-account                  which account is in each profile
#   claude-account check            full verification of the setup
#   claude-account logout <profile> end the session in one profile
#   claude-account login <profile>  start a session in one profile
#   claude-account routes           which folders route where
#   claude-account mark [dir]       color this folder's title bar for its profile
#   claude-account unmark [dir]     remove that marker
#   claude-account isolate [--apply] give each profile its own memory and history
#
# logout never deletes without a backup: credentials move into
# <config-home>/backups/ with a timestamp, so any switch can be undone.

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
LIB="$ROOT/lib/common.sh"

[ -f "$LIB" ] || { printf 'Cannot find the library at %s\n' "$LIB" >&2; exit 1; }
# shellcheck source=../lib/common.sh
. "$LIB"

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || true)}"
BACKUPS="$CAR_CONFIG_HOME/backups"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[90m%s\033[0m\n' "$*"; }
bold()  { printf '\033[1m%s\033[0m\n' "$*"; }

need_config() {
  car_load_config && return 0
  red "No config file at $CAR_CONFIG_FILE"
  dim "Create one with: claude-account-router --init"
  exit 1
}

# Does this email belong to a profile other than the one holding it?
foreign_profile_for() {
  local email="$1" own="$2" p glob
  [ -n "$email" ] || return 1
  for p in "${!CAR_PROFILE_GLOB[@]}"; do
    [ "$p" = "$own" ] && continue
    glob="${CAR_PROFILE_GLOB[$p]:-}"
    [ -n "$glob" ] && [ "$glob" != '*' ] || continue
    if car_glob_match "$email" "$glob"; then printf '%s' "$p"; return 0; fi
  done
  return 1
}

cmd_status() {
  need_config
  local p dir glob email foreign
  while read -r p; do
    dir="${CAR_PROFILE_DIR[$p]}"
    glob="${CAR_PROFILE_GLOB[$p]:-}"
    email="$(car_account_email "$dir")"
    bold "profile ${p}  (${dir})"
    if car_has_session "$dir"; then
      if foreign="$(foreign_profile_for "$email" "$p")"; then
        red "  ${email}   belongs to profile '${foreign}', not here"
      elif [ -n "$glob" ] && [ "$glob" != '*' ] && [ -n "$email" ] \
           && ! car_glob_match "$email" "$glob"; then
        red "  ${email}   does not match ${glob}"
      elif [ -z "$email" ]; then
        printf '  session active, email unreadable\n'
      else
        green "  ${email}"
      fi
    else
      dim "  no session"
    fi
  done < <(car_profile_names)
  printf '\n'
  dim "Routes:  claude-account routes"
  dim "Full check:  claude-account check"
}

cmd_routes() {
  need_config
  local i n
  n=${#CAR_ROUTE_PATHS[@]}
  if [ "$n" -eq 0 ]; then
    dim "No routes declared. Every folder uses profile '$CAR_DEFAULT_PROFILE'."
    return
  fi
  bold "Folder routes (worktrees of the same repo included)"
  for ((i = 0; i < n; i++)); do
    printf '  %-45s -> %s\n' "${CAR_ROUTE_PATHS[$i]}" "${CAR_ROUTE_PROFILES[$i]}"
  done
  printf '  %-45s -> %s\n' "(anything else)" "$CAR_DEFAULT_PROFILE"
}

resolve_profile() {  # sets RESOLVED_DIR
  local name="${1:-}"
  if [ -z "$name" ]; then
    red "Which profile? Declared: $(car_profile_names | tr '\n' ' ')"
    return 1
  fi
  RESOLVED_DIR="${CAR_PROFILE_DIR[$name]:-}"
  if [ -z "$RESOLVED_DIR" ]; then
    red "No profile named '$name'. Declared: $(car_profile_names | tr '\n' ' ')"
    return 1
  fi
  return 0
}

cmd_logout() {
  need_config
  local name="${1:-}" dir stamp identity reply
  resolve_profile "$name" || return 1
  dir="$RESOLVED_DIR"

  if ! car_has_session "$dir"; then
    dim "No session in profile '$name' ($dir). Nothing to end."
    return 0
  fi

  printf 'About to end the session in profile %s (%s)\n' "$name" "$dir"
  printf 'Account: %s\n' "$(car_account_email "$dir")"
  printf 'Continue? [y/N] '
  read -r reply
  case "$reply" in y|Y|yes|YES) ;; *) dim "Cancelled."; return 0 ;; esac

  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUPS"; chmod 700 "$BACKUPS"
  mv "$dir/.credentials.json" "$BACKUPS/${name}-credentials-$stamp.json"
  chmod 600 "$BACKUPS/${name}-credentials-$stamp.json"

  # Drop the stored identity too, so nothing keeps claiming an account that is
  # no longer logged in.
  identity="$(car_identity_file "$dir")"
  CAR_IDENTITY="$identity" CAR_BACKUP="$BACKUPS/${name}-identity-$stamp.json" python3 - <<'PY'
import json, os, shutil
p, bk = os.environ["CAR_IDENTITY"], os.environ["CAR_BACKUP"]
if os.path.exists(p):
    shutil.copy2(p, bk)
    try:
        with open(p) as f:
            d = json.load(f)
    except Exception:
        raise SystemExit(0)
    d.pop("oauthAccount", None); d.pop("userID", None)
    with open(p, "w") as f:
        json.dump(d, f, indent=2)
    os.chmod(p, 0o600)
PY
  green "Session ended. Backup in $BACKUPS"
  printf '\n'; cmd_status
}

cmd_login() {
  need_config
  local name="${1:-}" dir
  resolve_profile "$name" || return 1
  dir="$RESOLVED_DIR"

  if car_has_session "$dir"; then
    red "Profile '$name' already holds a session: $(car_account_email "$dir")"
    dim "End it first:  claude-account logout $name"
    return 1
  fi
  [ -n "$CLAUDE_BIN" ] || { red "Cannot find the 'claude' executable."; return 1; }
  [ -d "$dir" ] || { mkdir -p "$dir" && chmod 700 "$dir"; }

  bold "Logging in to profile '$name' ($dir)"
  local glob="${CAR_PROFILE_GLOB[$name]:-}"
  [ -n "$glob" ] && [ "$glob" != '*' ] && dim "Expected account: $glob"
  dim "Claude will open. Type  /login  and follow the browser link."
  dim "When done, type  /exit  and run:  claude-account"
  printf '\n'

  if [ "$dir" = "$HOME/.claude" ]; then
    env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN"
  else
    CLAUDE_CONFIG_DIR="$dir" "$CLAUDE_BIN"
  fi
  printf '\n'; cmd_status
}

# VS Code reads .vscode/settings.json from the folder you opened and does NOT
# inherit it from parent folders. So routing covers every subfolder of a routed
# path automatically, while a window marker has to be written into each folder
# you actually open. That is what these two commands are for.
cmd_mark() {
  need_config
  local dir profile color f
  dir="$(car_canonical "${1:-$PWD}")"
  [ -d "$dir" ] || { red "Not a directory: $dir"; return 1; }

  profile="$(car_profile_for_dir "$dir")"
  if [ "$profile" = "$CAR_DEFAULT_PROFILE" ]; then
    red "$dir routes to the default profile, so there is nothing to mark."
    dim "Markers exist to flag the folders that are NOT your usual account."
    return 1
  fi

  # One implementation for the marker, shared with the router's sync. See
  # car_write_marker in lib/common.sh.
  car_write_marker "$dir" "$profile" create || return 1

  color="${CAR_PROFILE_COLOR[$profile]:-$CAR_DEFAULT_COLOR}"
  f="$dir/.vscode/settings.json"
  green "Marked $dir as profile '$profile' ($color)"

  # Keep it out of a shared repository without editing tracked ignore files.
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    # A tracked marker is the one case where the ignore rule does nothing, so it comes first.
    #
    # Once the file is in the index, `check-ignore` reports nothing and `info/exclude` is not
    # consulted at all. Two things follow, and the second is the one that wastes an afternoon:
    # the marker travels with the repository, so whoever clones it inherits someone else's title
    # bar; and it lives or dies by the branch, because checking out a branch that does not carry
    # the file deletes it from disk. The bar disappears and nothing explains why.
    #
    # Found on 2026-08-30 in a repository where the marker had been committed since its first
    # commit. Renaming the project folder is what exposed it: re-marking looked like it worked,
    # and the next branch switch wiped it again.
    if git -C "$dir" ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      if git -C "$dir" rm --cached -q "$f" 2>/dev/null; then
        dim "The marker was tracked by git; removed from the index and left on disk."
        dim "Commit that removal, or the next branch switch deletes the marker again."
      else
        red "The marker is tracked by git and could not be removed from the index."
        red "Run: git -C $dir rm --cached .vscode/settings.json"
        red "Until then it travels with the repository and a branch switch deletes it."
      fi
    fi
    if git -C "$dir" check-ignore -q "$f" 2>/dev/null; then
      dim "Already git-ignored."
    else
      local excl
      excl="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/info/exclude"
      if mkdir -p "$(dirname "$excl")" 2>/dev/null; then
        grep -qxF '.vscode/' "$excl" 2>/dev/null || printf '.vscode/\n' >>"$excl"
        dim "Added .vscode/ to $excl (local only, the repo is untouched)."
      else
        red "Could not write $excl; add .vscode/ to your ignore rules by hand."
      fi
    fi
  fi
  dim "Reload the editor window to see it."
}

cmd_unmark() {
  need_config
  local dir
  dir="$(car_canonical "${1:-$PWD}")"
  [ -f "$dir/.vscode/settings.json" ] || { dim "No marker in $dir."; return 0; }
  # Passing the default profile is how the shared writer expresses removal.
  car_write_marker "$dir" "$CAR_DEFAULT_PROFILE" sync || return 1
  green "Unmarked $dir"
}

# Per-project memory and session history live under <config-dir>/projects. When
# a second profile is created by symlinking that directory, every account can
# read every other account's memory and transcripts. This moves each project
# directory into the profile that owns its folder.
#
# Prints the plan and changes nothing unless --apply is passed, because it moves
# directories that can hold gigabytes of history.
cmd_isolate() {
  need_config
  local apply=0 name cwd profile src dst target pdir p i moved=0 planned=0
  [ "${1:-}" = "--apply" ] && apply=1

  declare -A counts=()
  local -a plan_src=() plan_dst=()
  local -a view_slug=() view_profile=() view_target=()
  local shared=0 views=0 view_planned=0 view_skipped=0

  # A profile whose projects dir is a symlink to another one shares it entirely.
  # This must be undone BEFORE planning: while the link stands, source and
  # destination are literally the same directory, so every project looks like it
  # already sits with its own account and nothing gets planned. The state to be
  # fixed is the state that hides the need to fix it.
  while read -r p; do
    [ "$p" = "$CAR_DEFAULT_PROFILE" ] && continue
    target="$(car_projects_dir "$p")"
    [ -L "$target" ] || continue
    shared=$((shared + 1))
    if [ "$apply" -eq 1 ]; then
      rm "$target"; mkdir -p "$target"; chmod 700 "$target"
      dim "profile '$p' had a shared projects dir; it now has its own"
    else
      printf '  unshare  profile %-46s (its projects dir is a symlink)\n' "$p"
    fi
  done < <(car_profile_names)

  while read -r p; do
    pdir="$(car_projects_dir "$p")"
    [ -e "$pdir" ] || continue
    for src in "$pdir"/*/; do
      [ -d "$src" ] || continue
      src="${src%/}"
      # A history view link is not a misplaced project. It is the name the
      # editor reads, and it deliberately lives in the default profile pointing
      # elsewhere; moving it would carry it into the very profile it points at,
      # and it would then point at itself.
      if [ -L "$src" ]; then views=$((views + 1)); continue; fi
      name="$(basename "$src")"
      cwd="$(car_project_cwd "$src" || true)"
      if ! profile="$(car_profile_for_project "$name" "$cwd")"; then
        # No evidence of ownership. Leave it exactly where it is rather than
        # risk moving one account's history into another's.
        counts["unknown"]=$(( ${counts["unknown"]:-0} + 1 ))
        continue
      fi
      counts["$profile"]=$(( ${counts["$profile"]:-0} + 1 ))
      # The editor looks for this folder's history under the folder's own
      # encoded name in the default profile. Record the link it needs, unless
      # the folder is gone: history of a deleted worktree still belongs to its
      # account, but no editor window will ever ask for it by folder.
      if [ "$profile" != "$CAR_DEFAULT_PROFILE" ]; then
        if [ -n "$cwd" ] && [ -d "$cwd" ]; then
          view_slug+=("$(car_project_slug "$(car_canonical "$cwd")")")
          view_profile+=("$profile")
          view_target+=("$(car_projects_dir "$profile")/$name")
        else
          view_skipped=$((view_skipped + 1))
        fi
      fi
      target="$(car_projects_dir "$profile")"
      # Already in the right place? Compare canonically, since a shared dir
      # reached through a symlink is the same directory.
      [ "$(car_canonical "$(dirname "$src")")" = "$(car_canonical "$target")" ] && continue
      plan_src+=("$src"); plan_dst+=("$target/$name")
      planned=$((planned + 1))
      printf '  move  %-56s -> %s\n' "$(printf '%.56s' "$name")" "$profile"
    done
  done < <(car_profile_names)

  # Where the editor will look for each folder's history. Evaluated before
  # deciding there is nothing to do, because history can sit in exactly the
  # right account and still be invisible in the panel, which is the failure
  # that made this necessary.
  local vi state
  for vi in "${!view_slug[@]}"; do
    state="$(car_link_history_view "${view_slug[$vi]}" "${view_profile[$vi]}" plan \
             "${view_target[$vi]}")"
    case "$state" in
      ok) ;;
      link|relink|unlink)
        view_planned=$((view_planned + 1))
        printf '  %-8s %-54s -> %s\n' "$state" \
          "$(printf '%.54s' "${view_slug[$vi]}")" "${view_profile[$vi]}" ;;
      *)
        printf '  %-8s %-54s (left alone)\n' "$state" \
          "$(printf '%.54s' "${view_slug[$vi]}")" ;;
    esac
  done

  printf '\n'
  bold "Project directories per profile"
  for p in "${!counts[@]}"; do printf '  %-10s %s\n' "$p" "${counts[$p]}"; done
  printf '\n'

  if [ "$planned" -eq 0 ] && [ "$shared" -eq 0 ] && [ "$view_planned" -eq 0 ]; then
    green "Nothing to do: every project sits with its own account, and every folder's history is visible to the editor."
    return 0
  fi
  if [ "$apply" -eq 0 ]; then
    dim "$planned to move, $shared shared dir(s) to unshare, $view_planned view link(s) to write."
    [ "$view_skipped" -gt 0 ] \
      && dim "$view_skipped project(s) get no view link: their folder no longer exists."
    dim "Run 'claude-account isolate --apply' to perform."
    return 0
  fi
  # Every profile needs a real directory to receive its projects.
  while read -r p; do
    target="$(car_projects_dir "$p")"
    mkdir -p "$target"; chmod 700 "$target"
  done < <(car_profile_names)

  local f merged
  for i in "${!plan_src[@]}"; do
    if [ ! -e "${plan_dst[$i]}" ]; then
      mv "${plan_src[$i]}" "${plan_dst[$i]}" && moved=$((moved + 1))
      continue
    fi
    # Both sides hold sessions for the same folder. That happens because the
    # editor writes some session metadata without going through the router, so
    # a stray directory reappears in the default profile. Skipping would leave
    # those files in the wrong account, so merge: move every entry that is not
    # already there, and never overwrite one that is.
    merged=0
    local quarantine base twin
    quarantine="$CAR_CONFIG_HOME/orphaned/$(basename "${plan_dst[$i]}")"
    for f in "${plan_src[$i]}"/* "${plan_src[$i]}"/.[!.]*; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      twin="${plan_dst[$i]}/$base"
      if [ ! -e "$twin" ]; then
        mv "$f" "${plan_dst[$i]}/" && merged=$((merged + 1))
      elif cmp -s "$f" "$twin"; then
        rm -f "$f"          # byte for byte identical, the copy adds nothing
      else
        # Same session recorded on both sides with different content, typically
        # a metadata stub the editor wrote outside the router next to the real
        # transcript. Nothing is deleted and nothing is overwritten: the stub
        # goes to quarantine, out of the wrong account and out of Claude's way.
        mkdir -p "$quarantine"; chmod 700 "$quarantine"
        mv "$f" "$quarantine/$base" \
          && dim "quarantined a conflicting copy of $base"
      fi
    done
    if rmdir "${plan_src[$i]}" 2>/dev/null; then
      dim "merged $merged entries into $(basename "${plan_dst[$i]}")"
      moved=$((moved + 1))
    else
      dim "merged $merged entries; kept $(basename "${plan_src[$i]}"), it still holds files"
    fi
  done
  # Last, once every project sits with its account: name each folder's history
  # where the editor looks for it. A link written before the move would point at
  # a directory that is about to leave.
  local linked=0
  for vi in "${!view_slug[@]}"; do
    state="$(car_link_history_view "${view_slug[$vi]}" "${view_profile[$vi]}" apply \
             "${view_target[$vi]}")"
    case "$state" in link|relink|unlink) linked=$((linked + 1)) ;; esac
  done
  green "Moved or merged $moved project directories, wrote $linked history view link(s)."
  [ "$view_skipped" -gt 0 ] \
    && dim "$view_skipped project(s) got no link: their folder no longer exists."
  dim "Reload any open editor window so it reads from the new location."
}

case "${1:-status}" in
  status|'')      cmd_status ;;
  routes)         cmd_routes ;;
  isolate)        cmd_isolate "${2:-}" ;;
  mark)           cmd_mark "${2:-}" ;;
  unmark)         cmd_unmark "${2:-}" ;;
  check)          exec bash "$ROOT/bin/claude-account-check" ;;
  logout)         cmd_logout "${2:-}" ;;
  login)          cmd_login "${2:-}" ;;
  --version)      printf 'claude-account %s\n' "$CAR_VERSION" ;;
  --help|-h|help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    red "Unknown command '$1'."
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
